# Copy to .env.local. Both values are inlined at build time.
# Origin of the AdLens API: http://localhost:8080 locally, https://api.useadlens.com in production.
# Better Auth is served under {API}/api/auth; the app's own calls go to {API}/v1/*.
NEXT_PUBLIC_API_BASE_URL=
# Origin of this web app: http://localhost:3000 locally, https://www.useadlens.com in production.
# Used for page metadata. The links in emails are built by the API from its WEB_ORIGIN.
NEXT_PUBLIC_SITE_URL=
